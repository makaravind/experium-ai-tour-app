NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only, required by POST /api/scan. Supabase dashboard → Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=
# Shows the DebugPanel when exactly `true`. Inlined at build time, so redeploy after changing it.
NEXT_PUBLIC_DEBUG_ENABLED=false
